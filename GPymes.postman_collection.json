    {
      "name": "4. Actualizar pyme",
      "item": [
        {
          "name": "30 PUT con ganancias nuevas",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('ganancias = 2000', () => pm.expect(j.ganancias).to.eql(2000));",
            "pm.test('totalGastos sigue en 2700', () => pm.expect(j.totalGastos).to.eql(2700));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Panaderia\",\n  \"ganancias\": 2000\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/pymes/{{pymeId}}"
          }
        },
