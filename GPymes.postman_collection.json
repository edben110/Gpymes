          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('nombre cambiado', () => pm.expect(j.nombre).to.eql('Panaderia Central'));",
            "pm.test('ganancias NO se borran', () => pm.expect(j.ganancias).to.eql(2000));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Panaderia Central\"\n}", "options": { "raw": { "language": "json" } } },
