          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('resumen: mayor o igual, ojo', () => pm.expect(pm.response.json().resumen).to.include('mayor o igual a las ganancias'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/pymes/{{pymeId}}/gastos/total" }
        },
